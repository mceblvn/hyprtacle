# Maintainer: mceblvn <mceblvn@users.noreply.github.com>
pkgname=hyprtacle
pkgver=0.1.0
pkgrel=1
pkgdesc="KWin-compatible screenshot service for Hyprland — lets stock Spectacle take screenshots"
arch=('x86_64')
url="https://github.com/mceblvn/hyprtacle"
license=('BSD-3-Clause' 'LGPL-3.0-only')
depends=('grim' 'qt6-base')
optdepends=('hyprland: the compositor this service is for'
            'spectacle: the client this service is made for')
makedepends=('cmake' 'ninja' 'pkgconf')
install=hyprtacle.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('bfb610b24e585c6994199e0979cdc10def1b4554b640be64e0fa864402a17c3e')

build() {
    cd "$pkgname-$pkgver"
    cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_TESTING=OFF
    cmake --build build
}

package() {
    cd "$pkgname-$pkgver"
    DESTDIR="$pkgdir" cmake --install build
}
