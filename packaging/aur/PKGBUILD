# Maintainer: mceblvn <mceblvn@users.noreply.github.com>
pkgname=hyprtacle
pkgver=0.1.0
pkgrel=1
pkgdesc="KWin-compatible screenshot service for Hyprland — lets stock Spectacle take screenshots"
arch=('x86_64')
url="https://github.com/mceblvn/hyprtacle"
license=('BSD-3-Clause' 'LGPL-3.0-only')
depends=('grim' 'qt6-base')
optdepends=('hyprland: the compositor this service is for'
            'spectacle: the client this service is made for')
makedepends=('cmake' 'ninja' 'pkgconf')
source=("git+https://github.com/mceblvn/hyprtacle.git"
        "git+https://github.com/mceblvn/hyprtacle.git#tag=v$pkgver")
sha256sums=('SKIP' 'SKIP')

build() {
    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_TESTING=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}

post_install() {
    echo "The service has to run before Spectacle starts:"
    echo "  systemctl --user enable --now hyprtacled.service"
    echo "Check the environment with: hyprtacled --check"
}
